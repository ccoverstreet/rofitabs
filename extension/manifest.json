{
  "description": "Simple rofi tab integration",
  "manifest_version": 2,
  "name": "Rofitabs",
  "version": "1.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "rofitabs@jarmuz.com",
      "strict_min_version": "50.0"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": ["nativeMessaging", "tabs"]
}
